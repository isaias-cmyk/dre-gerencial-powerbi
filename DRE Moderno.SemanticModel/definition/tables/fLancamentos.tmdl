		displayFolder: _Legado
		lineageTag: ee19999b-74bd-42db-bafc-65e5016fdcda

	/// Valor de cada uma das 13 linhas de dDRE pela composição de grupos (ex.: linha 5 = grupos 1, 2 e 4). Subtotais ficam em branco no detalhamento por conta.
	measure 'DRE Base Realizado' =
			VAR Detalhe = ISINSCOPE(dPlanoConta[descricaoN1]) || ISINSCOPE(dPlanoConta[descricaoN2])
			VAR Subtotal = SELECTEDVALUE(dDRE[Subtotal], 0)
			RETURN IF(Detalhe && Subtotal = 1, BLANK(), SWITCH(SELECTEDVALUE(dDRE[Ordem]),
			1, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1})),
			2, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {2})),
			3, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2})),
			4, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {4})),
			5, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4})),
			6, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {6})),
			7, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {7})),
			8, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7})),
			9, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {9})),
			10, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {10})),
			11, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7,9,10})),
			12, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {12})),
			13, CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7,9,10,12})), BLANK()))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: DRE
		lineageTag: 984a3f7c-0e20-4e88-9354-160229ce98a8

	/// DRE Base Realizado no modo escolhido em dPeriodo: Seleção, Acumulado no ano (YTD) ou Ano completo.
	measure 'DRE Realizado' = SWITCH(SELECTEDVALUE(dPeriodo[Modo], "Seleção"), "Acumulado no ano", CALCULATE([DRE Base Realizado], DATESYTD(dCalendario[Data])), "Ano completo", CALCULATE([DRE Base Realizado], REMOVEFILTERS(dCalendario), VALUES(dCalendario[Ano])), [DRE Base Realizado])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: DRE
		lineageTag: 11ca29b8-7672-4e6a-9210-4e9894fb5754

	measure 'DRE Base Previsto' =
			VAR Detalhe = ISINSCOPE(dPlanoConta[descricaoN1]) || ISINSCOPE(dPlanoConta[descricaoN2])
			VAR Subtotal = SELECTEDVALUE(dDRE[Subtotal], 0)
			RETURN IF(Detalhe && Subtotal = 1, BLANK(), SWITCH(SELECTEDVALUE(dDRE[Ordem]),
			1, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1})),
			2, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {2})),
			3, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2})),
			4, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {4})),
			5, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4})),
			6, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {6})),
			7, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {7})),
			8, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7})),
			9, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {9})),
			10, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {10})),
			11, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7,9,10})),
			12, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {12})),
			13, CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7,9,10,12})), BLANK()))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		isHidden
		displayFolder: _Legado
		lineageTag: d68553a5-a658-42ee-9e5b-57b462d2bc19

	measure 'DRE Previsto' = SWITCH(SELECTEDVALUE(dPeriodo[Modo], "Seleção"), "Acumulado no ano", CALCULATE([DRE Base Previsto], DATESYTD(dCalendario[Data])), "Ano completo", CALCULATE([DRE Base Previsto], REMOVEFILTERS(dCalendario), VALUES(dCalendario[Ano])), [DRE Base Previsto])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		isHidden
		displayFolder: _Legado
		lineageTag: 1684676e-0f6d-4221-9533-c00b8374985c

	measure 'DRE Desvio R$' = IF(NOT ISBLANK([DRE Realizado]), [DRE Realizado]-[DRE Previsto])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		isHidden
		displayFolder: _Legado
		lineageTag: f7da9e57-9234-45d1-9cb1-a2d4fce38cf4

	measure 'DRE Desvio %' = DIVIDE([DRE Desvio R$], ABS([DRE Previsto]))
		formatString: 0.0%;(0.0%);0.0%
		isHidden
		displayFolder: _Legado
		lineageTag: 45ab2ed2-eadd-4e5d-988b-da69c620a220

	/// Análise vertical: linha da DRE ÷ receita líquida (linha 3) do mesmo contexto.
	measure 'DRE AV %' =
			VAR Receita = CALCULATE([DRE Realizado], REMOVEFILTERS(dDRE), dDRE[Ordem]=3, REMOVEFILTERS(dPlanoConta[descricaoN1],dPlanoConta[descricaoN2]))
			RETURN DIVIDE([DRE Realizado], Receita)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: DRE
		lineageTag: eefb2a26-d145-4231-84d9-ea656e35eb91

	measure 'DRE Ano Anterior' = CALCULATE([DRE Realizado], DATEADD(dCalendario[Data], -1, YEAR))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		isHidden
		displayFolder: _Legado
		lineageTag: a50a196c-7adc-4981-a2aa-ba2f6d8898a5

	measure 'DRE AH %' = IF(ISBLANK([DRE Realizado]) || ISBLANK([DRE Ano Anterior]), BLANK(), DIVIDE([DRE Realizado]-[DRE Ano Anterior], ABS([DRE Ano Anterior])))
		formatString: 0.0%;(0.0%);0.0%
		isHidden
		displayFolder: _Legado
		lineageTag: ae972bc6-1a61-48e2-9e29-65052736b49c

	measure 'DRE Cor Desvio' = IF(ISBLANK([DRE Desvio R$]), "#454545", IF([DRE Desvio R$]>=0,"#254B3F","#A33F36"))
		isHidden
		displayFolder: _Legado
		lineageTag: 9c0bfdb6-945a-43f9-b39e-f69c8a7ae86a

	measure 'DRE Cor Linha' = IF(SELECTEDVALUE(dDRE[Subtotal])=1,"#254B3F","#454545")
		displayFolder: Formatação
		lineageTag: 1ba80bf4-890a-4637-8230-67d98dc588db

	measure 'DRE Peso Linha' = IF(SELECTEDVALUE(dDRE[Subtotal])=1,"bold","normal")
		isHidden
		displayFolder: _Legado
		lineageTag: 32cdd9a4-9bd1-482c-92de-1e6e4bae805a

	measure 'DRE Situação' = IF(ISBLANK([DRE Realizado]), BLANK(), IF([DRE Desvio R$]>0,"↑ Favorável",IF([DRE Desvio R$]<0,"↓ Desfavorável","= Em linha")))
		isHidden
		displayFolder: _Legado
		lineageTag: 4b03b3c4-e39c-43e3-96cd-2fdb4014d70f

	measure 'Meses Realizados no Contexto' = COUNTROWS(CALCULATETABLE(VALUES(fLancamentos[competencia_data]), REMOVEFILTERS(dPlanoConta), REMOVEFILTERS(dEstruturaDRE), REMOVEFILTERS(dDRE)))
		formatString: 0
		displayFolder: Executivo/Cobertura
		lineageTag: ff7ca921-9afe-49fa-a270-16ceda608002

	/// 1 quando há um único ano selecionado e todos os seus meses com realizado existem no ano anterior; senão 0. Controla as comparações com o ano anterior.
	measure 'Comparação AA Disponível' =
			VAR Atual = CALCULATETABLE(VALUES(fLancamentos[competencia_data]), REMOVEFILTERS(dPlanoConta), REMOVEFILTERS(dEstruturaDRE), REMOVEFILTERS(dDRE))
			VAR Anterior = SELECTCOLUMNS(Atual,"DataAA",EDATE(fLancamentos[competencia_data],-12))
			VAR Existe = CALCULATETABLE(VALUES(fLancamentos[competencia_data]), REMOVEFILTERS(dCalendario), REMOVEFILTERS(dPlanoConta), REMOVEFILTERS(dEstruturaDRE), REMOVEFILTERS(dDRE), TREATAS(Anterior,dCalendario[Data]))
			RETURN IF(HASONEVALUE(dCalendario[Ano]) && COUNTROWS(Atual)>0 && COUNTROWS(Existe)=COUNTROWS(Atual),1,0)
		formatString: 0
		displayFolder: Executivo/Cobertura
		lineageTag: dc9750bb-a55c-4cca-a3fb-f0107795d6a2

	/// Orçamento restrito às competências que têm realizado no contexto (o realizado termina em mai/2023). Evita comparar meses realizados com o ano orçado inteiro.
	measure 'Orçamento Comparável' =
			VAR Datas = CALCULATETABLE(VALUES(fLancamentos[competencia_data]), REMOVEFILTERS(dPlanoConta), REMOVEFILTERS(dEstruturaDRE), REMOVEFILTERS(dDRE))
			RETURN IF(COUNTROWS(Datas)>0, CALCULATE([Valor Orçado], KEEPFILTERS(TREATAS(Datas,dCalendario[Data]))))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo
		lineageTag: 8236c49b-90ad-4505-bc1f-72310b5e33f4

	/// Realizado − orçamento comparável, ambos com sinal. Positivo = favorável (mais receita ou menos gasto).
	measure 'Impacto Orçamentário R$' =
			VAR Real = [Valor Realizado]
			VAR Orc = [Orçamento Comparável]
			RETURN IF(NOT ISBLANK(Real) && NOT ISBLANK(Orc), Real-Orc)
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo
		lineageTag: 10346b31-da5a-493b-8802-0b5ddb386df5

	measure 'Impacto Orçamentário %' = DIVIDE([Impacto Orçamentário R$],ABS([Orçamento Comparável]))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo
		lineageTag: 8a1082f4-8c52-4fec-a007-4b1ddee7f12f

	measure 'Cor Impacto Orçamentário' =
			VAR V = [Impacto Orçamentário R$]
			RETURN IF(ISBLANK(V),"#454545",IF(V>=0,"#254B3F","#A33F36"))
		displayFolder: Executivo/Formatação
		lineageTag: 7ef90587-e6a9-4e82-ab53-992b9cb054ed

	measure 'Receita Líquida Orçamento Comparável' = CALCULATE([Orçamento Comparável],KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2}))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
