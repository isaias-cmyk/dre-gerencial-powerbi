	/// Resultado líquido dos mesmos meses do ano anterior. Branco sem base comparável.
	measure 'Resultado Líquido AA Comparável' =
			VAR Datas = CALCULATETABLE(VALUES(fLancamentos[competencia_data]), REMOVEFILTERS(dPlanoConta), REMOVEFILTERS(dEstruturaDRE), REMOVEFILTERS(dDRE))
			VAR Anterior = SELECTCOLUMNS(Datas,"DataAA",EDATE(fLancamentos[competencia_data],-12))
			RETURN IF([Comparação AA Disponível]=1,CALCULATE([Resultado Líquido],REMOVEFILTERS(dCalendario),TREATAS(Anterior,dCalendario[Data])))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo
		lineageTag: 4d26d465-f765-4777-bbfe-183f593ee70c

	measure 'Resultado Líquido Δ AA' = IF(NOT ISBLANK([Resultado Líquido]) && NOT ISBLANK([Resultado Líquido AA Comparável]), [Resultado Líquido]-[Resultado Líquido AA Comparável])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo
		lineageTag: b702609c-ea08-49f0-a7cf-1782d86eccf3

	measure 'Resultado Líquido Δ Orçamento' = IF(NOT ISBLANK([Resultado Líquido]) && NOT ISBLANK([Resultado Líquido Orçamento Comparável]), [Resultado Líquido]-[Resultado Líquido Orçamento Comparável])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo
		lineageTag: bdd03e8b-058c-43b2-b468-c4582e9ad91e

	measure 'Resultado Líquido Comparativos' =
			VAR AA = [Resultado Líquido Δ AA]
			VAR Orc = [Resultado Líquido Δ Orçamento]
			VAR AAPct = DIVIDE(AA,ABS([Resultado Líquido AA Comparável]))
			VAR OrcPct = DIVIDE(Orc,ABS([Resultado Líquido Orçamento Comparável]))
			RETURN IF(ISBLANK([Resultado Líquido]),"Sem realizado no período",
			IF(ISBLANK(AA),"AA: comparação indisponível", "AA: " & FORMAT(AA/1000000,"+0.00;-0.00;0.00","pt-BR") & " mi (" & FORMAT(AAPct,"+0.0%;-0.0%;0.0%","pt-BR") & ")") & UNICHAR(10) &
			IF(ISBLANK(Orc),"Orçamento indisponível", "Orç: " & FORMAT(Orc/1000000,"+0.00;-0.00;0.00","pt-BR") & " mi (" & FORMAT(OrcPct,"+0.0%;-0.0%;0.0%","pt-BR") & ")") & UNICHAR(10) &
			IF(ISBLANK(Orc),"",IF(Orc>0,"↑ Favorável vs orçamento",IF(Orc<0,"↓ Desfavorável vs orçamento","Em linha com orçamento"))))
		displayFolder: Executivo/Cartões
		lineageTag: a10bdbc8-a835-4790-81f4-5ea4536b71d9

	measure 'Resultado Líquido Cor Executivo' =
			VAR V=[Resultado Líquido Δ Orçamento]
			RETURN IF(ISBLANK(V),"#454545",IF(V>=0,"#254B3F","#A33F36"))
		displayFolder: Executivo/Formatação
		lineageTag: 982a6a4a-686d-4b84-b602-168f9180cae8

	measure 'Margem Bruta AA Comparável' = DIVIDE([Lucro Bruto AA Comparável],[Receita Líquida AA Comparável])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo
		lineageTag: e79fc988-f335-495b-83cf-1ab3415304a8

	measure 'Margem Bruta Orçamento Comparável' = DIVIDE([Lucro Bruto Orçamento Comparável],[Receita Líquida Orçamento Comparável])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo
		lineageTag: a2600f23-211e-4625-901e-8bb4859a8310

	measure 'Margem Bruta Δ AA p.p.' = IF(NOT ISBLANK([Margem Bruta %]) && NOT ISBLANK([Margem Bruta AA Comparável]),100*([Margem Bruta %]-[Margem Bruta AA Comparável]))
		formatString: 0.0" p.p.";(0.0)" p.p.";0.0" p.p."
		displayFolder: Executivo
		lineageTag: 093bfaa4-dd8b-4a46-8699-3b172593db38

	measure 'Margem Bruta Δ Orçamento p.p.' = IF(NOT ISBLANK([Margem Bruta %]) && NOT ISBLANK([Margem Bruta Orçamento Comparável]),100*([Margem Bruta %]-[Margem Bruta Orçamento Comparável]))
		formatString: 0.0" p.p.";(0.0)" p.p.";0.0" p.p."
		displayFolder: Executivo
		lineageTag: 8f64eb55-a71d-4754-aacc-878bcb8999dc

	measure 'Margem Bruta Comparativos' =
			VAR AA=[Margem Bruta Δ AA p.p.]
			VAR Orc=[Margem Bruta Δ Orçamento p.p.]
			RETURN IF(ISBLANK([Margem Bruta %]),"Sem realizado no período",
			IF(ISBLANK(AA),"AA: comparação indisponível","AA: " & FORMAT(AA,"+0.0;-0.0;0.0","pt-BR") & " p.p.") & UNICHAR(10) &
			IF(ISBLANK(Orc),"Orçamento indisponível","Orç: " & FORMAT(Orc,"+0.0;-0.0;0.0","pt-BR") & " p.p.") & UNICHAR(10) & IF(ISBLANK(Orc),"",IF(Orc>0,"↑ Favorável vs orçamento",IF(Orc<0,"↓ Desfavorável vs orçamento","Em linha com orçamento"))))
		displayFolder: Executivo/Cartões
		lineageTag: 2c839ee8-3c7c-4fbd-9bf4-e8b2bb031816

	measure 'Margem Bruta Cor Executivo' =
			VAR V=[Margem Bruta Δ Orçamento p.p.]
			RETURN IF(ISBLANK(V),"#454545",IF(V>=0,"#254B3F","#A33F36"))
		displayFolder: Executivo/Formatação
		lineageTag: 13718a94-0628-4e64-b836-6a849511eeec

	measure 'Margem Líquida AA Comparável' = DIVIDE([Resultado Líquido AA Comparável],[Receita Líquida AA Comparável])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo
		lineageTag: a2ec56db-00f5-4b85-ad9e-f7bff4c285f7

	measure 'Margem Líquida Orçamento Comparável' = DIVIDE([Resultado Líquido Orçamento Comparável],[Receita Líquida Orçamento Comparável])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo
		lineageTag: 6ddac4ad-fcf3-49b0-ba02-5ead4eedcb43

	measure 'Margem Líquida Δ AA p.p.' = IF(NOT ISBLANK([Margem Líquida %]) && NOT ISBLANK([Margem Líquida AA Comparável]),100*([Margem Líquida %]-[Margem Líquida AA Comparável]))
		formatString: 0.0" p.p.";(0.0)" p.p.";0.0" p.p."
		displayFolder: Executivo
		lineageTag: 9242749e-29ce-4257-99bd-b57acc779b24

	measure 'Margem Líquida Δ Orçamento p.p.' = IF(NOT ISBLANK([Margem Líquida %]) && NOT ISBLANK([Margem Líquida Orçamento Comparável]),100*([Margem Líquida %]-[Margem Líquida Orçamento Comparável]))
		formatString: 0.0" p.p.";(0.0)" p.p.";0.0" p.p."
		displayFolder: Executivo
		lineageTag: 7b832ad0-4969-48dc-bc8e-ad5bd86150a3

	measure 'Margem Líquida Comparativos' =
			VAR AA=[Margem Líquida Δ AA p.p.]
			VAR Orc=[Margem Líquida Δ Orçamento p.p.]
			RETURN IF(ISBLANK([Margem Líquida %]),"Sem realizado no período",
			IF(ISBLANK(AA),"AA: comparação indisponível","AA: " & FORMAT(AA,"+0.0;-0.0;0.0","pt-BR") & " p.p.") & UNICHAR(10) &
			IF(ISBLANK(Orc),"Orçamento indisponível","Orç: " & FORMAT(Orc,"+0.0;-0.0;0.0","pt-BR") & " p.p.") & UNICHAR(10) & IF(ISBLANK(Orc),"",IF(Orc>0,"↑ Favorável vs orçamento",IF(Orc<0,"↓ Desfavorável vs orçamento","Em linha com orçamento"))))
		displayFolder: Executivo/Cartões
		lineageTag: 313ee34f-ec07-41a6-a833-e6b20f035e7f

	measure 'Margem Líquida Cor Executivo' =
			VAR V=[Margem Líquida Δ Orçamento p.p.]
			RETURN IF(ISBLANK(V),"#454545",IF(V>=0,"#254B3F","#A33F36"))
		displayFolder: Executivo/Formatação
		lineageTag: b0222bc4-afbd-498c-b35c-176225ee1ac4

	measure 'Receita Desvio Orçamento %' = DIVIDE([Receita Líquida Δ Orçamento],ABS([Receita Líquida Orçamento Comparável]))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo
		lineageTag: e53ccd73-489e-4be5-8e59-b72edd6459c9

	measure 'Resultado Desvio Orçamento %' = DIVIDE([Resultado Líquido Δ Orçamento],ABS([Resultado Líquido Orçamento Comparável]))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo
		lineageTag: cd4e97f2-9287-4c2d-8298-c3453f89fcc2

	measure 'DRE Base Orçamento Comparável' =
			VAR Detalhe = ISINSCOPE(dPlanoConta[descricaoN1]) || ISINSCOPE(dPlanoConta[descricaoN2])
			VAR Subtotal = SELECTEDVALUE(dDRE[Subtotal], 0)
			RETURN IF(Detalhe && Subtotal = 1, BLANK(), SWITCH(SELECTEDVALUE(dDRE[Ordem]),
			1, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1})),
			2, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {2})),
			3, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2})),
			4, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {4})),
			5, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4})),
			6, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {6})),
			7, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {7})),
			8, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7})),
			9, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {9})),
			10, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {10})),
			11, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7,9,10})),
			12, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {12})),
			13, CALCULATE([Orçamento Comparável], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1,2,4,6,7,9,10,12})), BLANK()))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/DRE
		lineageTag: 950016a6-7ff3-4c1e-9c4b-15544a4ed7e0

	/// Linha da DRE no orçamento comparável, no mesmo modo de período da DRE Realizado.
	measure 'DRE Orçamento Comparável' = SWITCH(SELECTEDVALUE(dPeriodo[Modo],"Seleção"),"Acumulado no ano",CALCULATE([DRE Base Orçamento Comparável],DATESYTD(dCalendario[Data])),"Ano completo",CALCULATE([DRE Base Orçamento Comparável],REMOVEFILTERS(dCalendario),VALUES(dCalendario[Ano])),[DRE Base Orçamento Comparável])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/DRE
		lineageTag: 9f872d3d-4bfe-4c5b-8628-1cfe8293fdb5

	measure 'DRE Impacto Orçamentário R$' = IF(NOT ISBLANK([DRE Realizado]) && NOT ISBLANK([DRE Orçamento Comparável]),[DRE Realizado]-[DRE Orçamento Comparável])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/DRE
		lineageTag: a33db01c-8f8e-4c70-876f-13e747fab31c

	measure 'DRE Impacto Orçamentário %' = DIVIDE([DRE Impacto Orçamentário R$],ABS([DRE Orçamento Comparável]))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo/DRE
		lineageTag: 13e10248-d6ab-46d9-acf3-57ac5bdfea8b

	measure 'DRE Cor Orçamento' =
			VAR V=[DRE Impacto Orçamentário R$]
			RETURN IF(ISBLANK(V),"#454545",IF(V>=0,"#254B3F","#A33F36"))
		displayFolder: Executivo/Formatação
		lineageTag: fb758c21-0f51-410b-8b97-4111ee22d113

	measure 'DRE Base AA Comparável' =
			VAR Datas=CALCULATETABLE(VALUES(fLancamentos[competencia_data]), REMOVEFILTERS(dPlanoConta), REMOVEFILTERS(dEstruturaDRE), REMOVEFILTERS(dDRE))
			VAR Anterior=SELECTCOLUMNS(Datas,"DataAA",EDATE(fLancamentos[competencia_data],-12))
			RETURN IF([Comparação AA Disponível]=1,CALCULATE([DRE Base Realizado],REMOVEFILTERS(dCalendario),TREATAS(Anterior,dCalendario[Data])))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/DRE
		lineageTag: e22e171d-b005-4806-8f0b-aa035b3e0901

	measure 'DRE AA Comparável' = SWITCH(SELECTEDVALUE(dPeriodo[Modo],"Seleção"),"Acumulado no ano",CALCULATE([DRE Base AA Comparável],DATESYTD(dCalendario[Data])),"Ano completo",CALCULATE([DRE Base AA Comparável],REMOVEFILTERS(dCalendario),VALUES(dCalendario[Ano])),[DRE Base AA Comparável])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/DRE
		lineageTag: e3872976-80bf-46e6-800a-6c0ce2801c98

	/// Análise horizontal: variação contra os mesmos meses do ano anterior, dividida pelo módulo da base. Branco sem base (nunca −100%).
	measure 'DRE AH Comparável %' = IF(NOT ISBLANK([DRE Realizado]) && NOT ISBLANK([DRE AA Comparável]),DIVIDE([DRE Realizado]-[DRE AA Comparável],ABS([DRE AA Comparável])))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo/DRE
		lineageTag: fff6b552-c2ed-47d6-95b5-1129548637ff

	measure 'DRE Resultado Operacional' = SWITCH(SELECTEDVALUE(dPeriodo[Modo],"Seleção"),"Acumulado no ano",CALCULATE([Resultado Operacional],DATESYTD(dCalendario[Data])),"Ano completo",CALCULATE([Resultado Operacional],REMOVEFILTERS(dCalendario),VALUES(dCalendario[Ano])),[Resultado Operacional])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/DRE
		lineageTag: 32898073-ede9-4f9f-9ff3-0153002879d8

	measure 'DRE Impacto Conta R$' = SWITCH(SELECTEDVALUE(dPeriodo[Modo],"Seleção"),"Acumulado no ano",CALCULATE([Impacto Orçamentário R$],DATESYTD(dCalendario[Data])),"Ano completo",CALCULATE([Impacto Orçamentário R$],REMOVEFILTERS(dCalendario),VALUES(dCalendario[Ano])),[Impacto Orçamentário R$])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/DRE
		lineageTag: 1a05e37c-af24-42e2-a0ad-f4250f71dcc5

	measure 'DRE Impacto Conta %' = SWITCH(SELECTEDVALUE(dPeriodo[Modo],"Seleção"),"Acumulado no ano",CALCULATE([Impacto Orçamentário %],DATESYTD(dCalendario[Data])),"Ano completo",CALCULATE([Impacto Orçamentário %],REMOVEFILTERS(dCalendario),VALUES(dCalendario[Ano])),[Impacto Orçamentário %])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Executivo/DRE
		lineageTag: aca34327-22cb-4a26-b62e-4dcec48927a8

	measure 'DRE Cor Impacto Conta' =
			VAR V=[DRE Impacto Conta R$]
			RETURN IF(ISBLANK(V),"#454545",IF(V>=0,"#254B3F","#A33F36"))
		displayFolder: Executivo/Formatação
		lineageTag: 5d83e9c6-ee25-460d-b663-8a9f24ccf174

	measure 'Ranking Impacto Conta' =
			VAR V=[DRE Impacto Conta R$]
			RETURN IF(NOT ISBLANK(V), RANKX(ALLSELECTED(dPlanoConta[descricaoN2]),ABS([DRE Impacto Conta R$]),ABS(V),DESC,Dense))
		formatString: 0
		displayFolder: Executivo/Desvios
		lineageTag: 63f4c883-163a-4b9f-bb70-333597b7e19e

	/// Impacto orçamentário das 8 contas (descricaoN2) com maior impacto absoluto no contexto.
	measure 'Top 8 Impacto Conta' = IF([Ranking Impacto Conta]<=8 && NOT ISBLANK([Ranking Impacto Conta]),[DRE Impacto Conta R$])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/Desvios
		lineageTag: f0fc0dac-226e-46e0-9ee6-6ca70114f89b

	/// Linhas 3, 4, 6, 7, 9, 10 e 12 para a cascata; o total da cascata é igual ao resultado líquido.
	measure 'Componente Waterfall DRE' = IF(SELECTEDVALUE(dDRE[Ordem]) IN {3,4,6,7,9,10,12},[DRE Realizado])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/Waterfall
		lineageTag: 3c33ffe5-ff49-4772-ab96-1d3309ba6343

	measure 'Resultado Mensal Negativo' = IF([Resultado Líquido]<0,[Resultado Líquido])
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/Gráficos
		lineageTag: b244a96a-7b26-4eca-bcea-31938afe087f

	measure 'Referência Zero' = IF(NOT ISBLANK([Resultado Líquido]) || NOT ISBLANK([Resultado Líquido Orçada]),0)
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Executivo/Gráficos
		lineageTag: 55053fe6-b4cb-4e24-a747-4257b47fe980

	/// Texto do cabeçalho: ano ou faixa de anos, filial e quantidade de meses com realizado.
	measure 'Contexto Executivo' =
			VAR AnoMin = MIN(dCalendario[Ano])
			VAR AnoMax = MAX(dCalendario[Ano])
			VAR Anos = IF(AnoMin = AnoMax, FORMAT(AnoMin, "0"), FORMAT(AnoMin, "0") & "–" & FORMAT(AnoMax, "0"))
			RETURN "XPBucks • " & Anos & " • " & IF(HASONEVALUE(dFilial[Filial]), SELECTEDVALUE(dFilial[Filial]), "Filiais selecionadas") & " • " & FORMAT([Meses Realizados no Contexto], "0") & " meses com realizado"
		displayFolder: Executivo/Texto
		lineageTag: 3d0d2781-3d56-4189-9941-e636361eaa0f

	measure 'Insight Receita' =
			VAR V=[Receita Líquida Δ Orçamento]
			RETURN IF(ISBLANK(V),"Receita: comparação orçamentária indisponível.","Receita " & IF(V>=0,"acima","abaixo") & " do orçamento em " & FORMAT(ABS(V)/1000000,"0.00","pt-BR") & " mi, nos meses com realizado.")
		displayFolder: Executivo/Insights
		lineageTag: 25d72761-2088-44fb-8156-11200fe2e1a7

	measure 'Insight Margem' =
			VAR V=[Margem Bruta Δ AA p.p.]
			RETURN IF(ISBLANK(V),"Margem: selecione um ano com base anterior comparável.","Margem bruta " & IF(V>=0,"aumentou ","diminuiu ") & FORMAT(ABS(V),"0.0","pt-BR") & " p.p. frente aos mesmos meses do ano anterior.")
		displayFolder: Executivo/Insights
		lineageTag: 7df9e964-c90d-4bf1-b3f0-1938df378fdc

	measure 'Insight Custos' =
			VAR V=CALCULATE([Impacto Orçamentário R$],KEEPFILTERS(dPlanoConta[GrupoDRE]=4))
			RETURN IF(ISBLANK(V),"Custos: comparação indisponível.","Custos: impacto " & IF(V>=0,"favorável","desfavorável") & " de " & FORMAT(ABS(V)/1000000,"0.00","pt-BR") & " mi frente ao orçamento comparável.")
		displayFolder: Executivo/Insights
		lineageTag: 185a16bf-bfd1-4cd3-bfa4-5b09bb144875

	measure 'Insight Filial' =
			VAR T=FILTER(ADDCOLUMNS(ALLSELECTED(dFilial[Filial]),"Valor",[Resultado Líquido]),NOT ISBLANK([Valor]))
			VAR Lider=TOPN(1,T,[Valor],DESC,dFilial[Filial],ASC)
			RETURN IF(COUNTROWS(T)=0,"Filiais: sem realizado no contexto.","Maior resultado entre as filiais selecionadas: " & CONCATENATEX(Lider,dFilial[Filial],", ") & " (R$ " & FORMAT(MAXX(Lider,[Valor])/1000000,"0.00","pt-BR") & " mi).")
		displayFolder: Executivo/Insights
		lineageTag: 9a7c2027-432f-4d58-805e-97e80f8fbc69

	measure 'Insight Despesa' =
			VAR T=CALCULATETABLE(ADDCOLUMNS(ALLSELECTED(dPlanoConta[descricaoN2]),"Impacto",[DRE Impacto Conta R$]),KEEPFILTERS(dPlanoConta[GrupoDRE]=6))
			VAR Neg=FILTER(T,NOT ISBLANK([Impacto]) && [Impacto]<0)
			VAR Lider=TOPN(1,Neg,[Impacto],ASC,dPlanoConta[descricaoN2],ASC)
			RETURN IF(ISBLANK([DRE Resultado Operacional]),"Despesas: sem realizado no contexto.",IF(COUNTROWS(Neg)=0,"Nenhum desvio desfavorável de despesa no contexto comparável.","Maior desvio desfavorável de despesa: " & CONCATENATEX(Lider,dPlanoConta[descricaoN2],", ") & " (R$ " & FORMAT(ABS(MINX(Lider,[Impacto]))/1000,"0.0","pt-BR") & " mil)."))
		displayFolder: Executivo/Insights
		lineageTag: 6c081089-743c-4f2a-8d12-4d315b04b293

	measure 'Síntese Executiva' = [Insight Receita] & UNICHAR(10) & [Insight Margem] & UNICHAR(10) & [Insight Filial]
		displayFolder: Executivo/Insights
		lineageTag: 379fa268-216c-4aec-a98c-859195cdd10b

