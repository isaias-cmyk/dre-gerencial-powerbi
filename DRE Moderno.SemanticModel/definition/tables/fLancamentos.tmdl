	measure 'Resultado Ano Anterior' = CALCULATE([Resultado Líquido], DATEADD(dCalendario[Data], -1, YEAR))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		isHidden
		displayFolder: _Legado
		lineageTag: 0df43240-0be2-4f05-b4fe-7e06b2b2c6b0

	measure 'Variação YoY %' = IF(ISBLANK([Resultado Líquido]) || ISBLANK([Resultado Ano Anterior]), BLANK(), DIVIDE([Resultado Líquido]-[Resultado Ano Anterior], ABS([Resultado Ano Anterior])))
		formatString: 0.0%;(0.0%);0.0%
		isHidden
		displayFolder: _Legado
		lineageTag: 806fb5c0-147c-4c14-93ca-fbc17569542b

	measure 'Receita Ano Anterior' = CALCULATE([Receita Líquida], DATEADD(dCalendario[Data], -1, YEAR))
