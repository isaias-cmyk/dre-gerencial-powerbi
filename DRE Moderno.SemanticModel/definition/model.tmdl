model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dEstruturaDRE","dPlanoConta","fOrcamento","fPrevisao","fLancamento1_ano1","fLancamento2_ano1","fLancamento3_ano1","fLancamento1_ano2","fLancamento2_ano2","fLancamento3_ano2","fLancamento1_ano3","fLancamento2_ano3","fLancamento3_ano3","fLancamentos","dFilial","dCalendario","pArquivoBase"]

ref table dEstruturaDRE
ref table dPlanoConta
ref table fOrcamento
ref table fPrevisao
ref table fLancamentos
ref table dFilial
ref table dCalendario
ref table dDRE
ref table dPeriodo

ref cultureInfo en-US

