	/// Lucro bruto ÷ receita líquida. Branco quando não há receita.
	measure 'Margem Bruta %' = DIVIDE([Lucro Bruto], [Receita Líquida])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: DRE
		lineageTag: 59811970-f84d-4d4e-8956-6c3458711deb

	measure 'Margem Operacional %' = DIVIDE([Resultado Operacional], [Receita Líquida])
