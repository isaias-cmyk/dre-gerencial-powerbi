table fLancamentos
	lineageTag: 0f79e324-3c5c-40b3-8790-c3310baf141c

	/// Realizado com sinal contábil: SUMX(valor × dPlanoConta[tipoLancamento]). Receitas positivas, custos e despesas negativos. Base de todas as medidas de realizado.
	measure 'Valor Realizado' = SUMX(fLancamentos, fLancamentos[valor] * RELATED(dPlanoConta[tipoLancamento]))
		formatString: #,##0.00
		lineageTag: ee2133a1-2a48-44df-a722-627f7103bbf9

	measure 'Registros Realizados' = COUNTROWS(fLancamentos)
		formatString: 0
		isHidden
		displayFolder: _Legado
		lineageTag: 2a50d464-01f9-46d1-8d80-9da6d0f03d82

	/// Realizado do grupo DRE 1 (receita operacional bruta).
	measure 'Receita Bruta' = CALCULATE([Valor Realizado], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1}))
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00
		displayFolder: Indicadores realizados
		lineageTag: 40ea3794-024d-41eb-90a1-7674e65ffae1

	measure 'Receita Bruta Prevista' = CALCULATE([Valor Previsto], KEEPFILTERS(dPlanoConta[GrupoDRE] IN {1}))
