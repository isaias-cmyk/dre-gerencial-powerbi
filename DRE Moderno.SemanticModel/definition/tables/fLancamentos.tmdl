	/// Receita líquida da filial ÷ receita líquida de todas as filiais selecionadas.
	measure 'Participação Receita Filial %' = DIVIDE([Receita Líquida], CALCULATE([Receita Líquida], ALLSELECTED(dFilial)))
		formatString: 0.0%;(0.0%);0.0%
